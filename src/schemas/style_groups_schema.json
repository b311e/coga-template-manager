{
  "title": "templx Style Groups Schema",
  "version": "1.0",
  "description": "Schema defining style groups and priority for Word document templates in the templx system. If styles are not noted in this schema, then they are added to the style group: other.",
  "style_groups": [
    {
      "style_group": "doc_default",
      "description": "Document default settings"
    },
    {
      "style_group": "default",
      "description": "Default styles built into Word",
      "styles": [
        "Normal",
        "DefaultParagraphFont",
        "TableNormal",
        "NoList"
      ]
    },
    {
      "style_group": "heading",
      "description": "Heading styles",
      "styles": [
        "Heading1",
        "Heading2",
        "Heading3",
        "Heading4",
        "Heading5",
        "Heading6",
        "Heading7",
        "Heading8",
        "Heading9"
      ]
    },
    {
      "style_group": "body",
      "description": "Body text styles",
      "styles": [
        "NoSpacing",
        "SpaceBefore"
      ]
    },
    {
      "style_group": "front_matter",
      "description": "Styles for cover page, title page, or letterhead front matter. Title should always be hidden.",
      "styles": [
        "Title",
        "Subtitle",
        "Pretitle",
        "Author",
        "Date"
      ]
    },
    {
      "style_group": "list",
      "description": "List styles",
      "styles": [
        "ListParagraph",
        "ListBullet",
        "ListBullet2",
        "ListBullet3",
        "ListBullet4",
        "ListBullet5",
        "ListBulletSpacing",
        "ListNumber",
        "ListNumber2",
        "ListNumber3",
        "ListNumber4",
        "ListNumber5",
        "ListNumberSpacing"
      ]
    },
    {
      "style_group": "callout",
      "description": "Callout styles, including quote and block text.",
      "styles": [
        "BlockText",
        "Quote",
        "IntenseQuote"
      ]
    },
    {
      "style_group": "caption",
      "description": "Caption styles",
      "styles": [
        "Caption",
        "Source"
      ]
    },
    {
      "style_group": "toc",
      "description": "Table of contents styles",
      "styles": [
        "TOCHeading",
        "TOC1",
        "TOC2",
        "TOC3",
        "TOC4",
        "TOC5",
        "TOC6",
        "TOC7",
        "TOC8",
        "TOC9"
      ]
    },
    {
      "style_group": "index",
      "description": "Index styles",
      "styles": [
        "IndexHeading",
        "Index1",
        "Index2",
        "Index3",
        "Index4",
        "Index5",
        "Index6",
        "Index7",
        "Index8",
        "Index9"
      ]
    },
    {
      "style_group": "header",
      "description": "Header styles",
      "styles": [
        "Header"
      ]
    },
    {
      "style_group": "footer",
      "description": "Footer styles",
      "styles": [
        "Footer",
        "FootnoteText",
        "FootnoteReference",
        "EndnoteReference",
        "EndnoteText"
      ]
    },
    {
      "style_group": "character",
      "description": "Character styles",
      "styles": [
        "Hyperlink",
        "Strong",
        "Emphasis",
        "IntenseEmphasis",
        "SubtleEmphasis",
        "IntenseReference",
        "SubtleReference",
        "BookTitle",
        "Note"
      ]
    },
    {
      "style_group": "table",
      "description": "Table styles, including table titles and descriptions.",
      "styles": [
        "TableTitle",
        "TableDescription"
      ]
    },
    {
      "style_group": "other",
      "description": "Template-specific styles",
      "styles": [

      ]
    }
  ]
}

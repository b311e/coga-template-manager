#!/usr/bin/env bash
# templx cleanup command dispatcher

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SUBCOMMAND="${1:-}"

show_help() {
    cat <<EOF
Usage: templx cleanup <subcommand> [args...]

Subcommands:
  wordml <expanded-dir>    - Full automated cleanup of WordprocessingML files
  linkchar <styles.xml>    - Remove linked character styles from styles.xml
  noproof <xml-file>       - Remove noProof elements from a Word XML file
  tracking <xml-file>      - Remove RSID/tracking attributes from a Word XML file
EOF
}

case "$SUBCOMMAND" in
    wordml)
        shift
        exec "$SCRIPT_DIR/cleanup-wordml" "$@"
        ;;
    linkchar|noproof|tracking)
        shift
        exec python "$SCRIPT_DIR/cleanup-$SUBCOMMAND" "$@"
        ;;
    help|--help|-h|"")
        show_help
        ;;
    *)
        echo "Unknown cleanup subcommand: $SUBCOMMAND" >&2
        echo "Run 'templx cleanup help' for usage information." >&2
        exit 1
        ;;
esac

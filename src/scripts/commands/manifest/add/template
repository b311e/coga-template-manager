#!/usr/bin/env bash
# templx manifest add template - print instructions for adding a new template

set -euo pipefail

if [[ "${1:-}" == "help" || "${1:-}" == "--help" || "${1:-}" == "-h" ]] || [[ $# -lt 3 ]]; then
    cat <<EOF
Usage: templx manifest add template <agency> <template> <type>

Print instructions for adding a new template to the project.

Arguments:
  agency    - Agency code (e.g., jbc, base)
  template  - Template name (e.g., jbcReport)
  type      - One of: word-doc-template, excel-book-template, excel-sheet-template
EOF
    [[ $# -lt 3 ]] && exit 1
    exit 0
fi

agency="$1"
template="$2"
type="$3"

cat <<EOF
To add a new template '$template' to agency '$agency':

1. Create the build folder structure:
   mkdir -p builds/$agency/templates/$template/{src,out,in,docs,config}

2. Copy and fill in config shells:
   cp src/shells/_config_build.json builds/$agency/templates/$template/config/config_build.json
   cp src/shells/_config_styles.json builds/$agency/templates/$template/config/_config_styles.json
   # Copy the appropriate field shell from src/shells/fields/, for example:
   cp src/shells/fields/_committeeLetterhead.json builds/$agency/templates/$template/config/config_fields.json

3. Regenerate the master manifest:
   templx manifest generate
EOF

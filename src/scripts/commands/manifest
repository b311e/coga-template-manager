#!/usr/bin/env bash
# templx manifest command dispatcher

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SUBCOMMAND="${1:-}"

show_help() {
    cat <<EOF
Usage: templx manifest <subcommand> [args...]

Subcommands:
  generate                                       - Regenerate master manifest at .templx/registry/manifest.json
  validate                                       - Validate master manifest
  list                                           - List all builds and templates
  update status <agency> <template> <status>     - Update a template's status in the master manifest
  add template <agency> <template> <type>        - Print instructions for adding a new template

Examples:
  templx manifest generate
  templx manifest update status jbc jbcMemo active
  templx manifest add template jbc jbcReport word-doc-template
EOF
}

case "$SUBCOMMAND" in
    generate)
        shift
        exec "$SCRIPT_DIR/manifest.generate" "$@"
        ;;
    validate)
        shift
        exec "$SCRIPT_DIR/manifest.validate" "$@"
        ;;
    list)
        shift
        exec "$SCRIPT_DIR/manifest.list" "$@"
        ;;
    update)
        shift
        exec "$SCRIPT_DIR/manifest.update" "$@"
        ;;
    add)
        shift
        exec "$SCRIPT_DIR/manifest.add" "$@"
        ;;
    help|--help|-h|"")
        show_help
        ;;
    *)
        echo "Unknown manifest subcommand: $SUBCOMMAND" >&2
        echo "Run 'templx manifest help' for usage information." >&2
        exit 1
        ;;
esac

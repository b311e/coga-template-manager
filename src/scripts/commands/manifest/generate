#!/usr/bin/env bash
# templx manifest generate - regenerate the master manifest at .templx/registry/manifest.json

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"

if [[ "${1:-}" == "help" || "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    cat <<EOF
Usage: templx manifest generate

Scans builds/<agency>/{workspace,templates}/<template>/ directories
and regenerates the master manifest at .templx/registry/manifest.json.
EOF
    exit 0
fi

# Helper: process a single template directory and emit a JSON entry
process_single_template() {
    local template_dir="$1"
    local agency="$2"

    [[ ! -d "$template_dir" ]] && return 1

    local dir_name
    dir_name=$(basename "$template_dir")
    local config_file="$template_dir/config/config.json"
    local dir_path="${template_dir#$PROJECT_ROOT/}"

    local key="$dir_name"
    local collection=""
    local status="active"
    local ext=""
    local type=""

    if [[ -f "$config_file" ]]; then
        local config_key config_collection config_status config_ext
        config_key=$(grep '"key"' "$config_file" | sed 's/.*"key"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')
        config_collection=$(grep '"collection"' "$config_file" | sed 's/.*"collection"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')
        config_status=$(grep '"status"' "$config_file" | sed 's/.*"status"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')
        config_ext=$(grep '"extension"' "$config_file" | sed 's/.*"extension"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')

        [[ -n "$config_key" ]] && key="$config_key"
        [[ -n "$config_collection" ]] && collection="$config_collection"
        [[ -n "$config_status" ]] && status="$config_status"
        [[ -n "$config_ext" ]] && ext=".$config_ext"
    fi

    key="${key#$agency}"
    key="${key#_}"
    key=$(echo "$key" | sed 's/\([A-Z]\)/_\L\1/g' | sed 's/^_//')

    [[ -z "$collection" ]] && collection="$key"

    if [[ -z "$ext" ]]; then
        for template_file in "$template_dir"/out/*.{dotm,dotx,xltx,xltm} "$template_dir"/src/*.{dotm,dotx,xltx,xltm}; do
            [[ -f "$template_file" ]] && [[ $(basename "$template_file") != ~\$* ]] && {
                ext=".${template_file##*.}"
                break
            }
        done
    fi

    case "$ext" in
        .dotm|.dotx) type="word-doc-template" ;;
        .xltx|.xltm) type="excel-book-template" ;;
        *) type="" ;;
    esac

    local partials_json=""
    local partials_dir="$template_dir/partials"
    local first_partial=true

    if [[ -d "$partials_dir" ]]; then
        for partial_type in styles numbering macros; do
            local subdir="$partials_dir/$partial_type"
            [[ ! -d "$subdir" ]] && continue

            local glob
            case "$partial_type" in
                macros) glob='*.bas *.cls' ;;
                *) glob='*.xml' ;;
            esac

            for partial_file in $subdir/$glob; do
                [[ ! -f "$partial_file" ]] && continue
                local partial_rel_path="${partial_file#$PROJECT_ROOT/}"
                local partial_id
                partial_id=$(basename "$partial_file" | sed 's/\.[^.]*$//')
                partial_id="${partial_id#$agency}"
                partial_id="${partial_id#-}"
                partial_id="${partial_id#_}"

                local entry="            \"$partial_id\": {\n              \"path\": \"$partial_rel_path\",\n              \"partial_type\": \"$partial_type\"\n            }"
                if $first_partial; then
                    partials_json="$entry"
                    first_partial=false
                else
                    partials_json="$partials_json,\n$entry"
                fi
            done
        done
    fi

    if [[ -n "$partials_json" ]]; then
        echo "        \"$key\": {\n          \"type\": \"$type\",\n          \"extension\": \"$ext\",\n          \"directory\": \"$dir_path\",\n          \"collection\": \"$collection\",\n          \"status\": \"$status\",\n          \"partials\": {\n$partials_json\n          }\n        }"
    else
        echo "        \"$key\": {\n          \"type\": \"$type\",\n          \"extension\": \"$ext\",\n          \"directory\": \"$dir_path\",\n          \"collection\": \"$collection\",\n          \"status\": \"$status\"\n        }"
    fi
}

generate_manifest() {
    local registry_dir="$PROJECT_ROOT/.templx/registry"
    local manifest_file="$registry_dir/manifest.json"
    local timestamp
    timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

    echo "Generating master manifest"
    echo "Scanning builds directory: $PROJECT_ROOT/builds"
    echo "Manifest file: $manifest_file"

    mkdir -p "$registry_dir"

    local builds_json=""
    local first_build=true

    for build_dir in "$PROJECT_ROOT/builds"/*; do
        [[ ! -d "$build_dir" ]] && continue
        local build_name
        build_name=$(basename "$build_dir")

        [[ "$build_name" == "manifests" ]] && continue
        [[ "$build_name" == "tmp" ]] && continue

        echo "  Processing build: $build_name"

        local workspace_json=""
        local first_workspace=true
        if [[ -d "$build_dir/workspace" ]]; then
            for template_dir in "$build_dir/workspace"/*; do
                [[ ! -d "$template_dir" ]] && continue
                local template_entry
                template_entry=$(process_single_template "$template_dir" "$build_name")
                if [[ -n "$template_entry" ]]; then
                    if $first_workspace; then
                        workspace_json="$template_entry"
                        first_workspace=false
                    else
                        workspace_json="$workspace_json,\n$template_entry"
                    fi
                fi
            done
        fi

        local templates_json=""
        local first_template=true
        if [[ -d "$build_dir/templates" ]]; then
            for template_dir in "$build_dir/templates"/*; do
                [[ ! -d "$template_dir" ]] && continue
                local template_entry
                template_entry=$(process_single_template "$template_dir" "$build_name")
                if [[ -n "$template_entry" ]]; then
                    if $first_template; then
                        templates_json="$template_entry"
                        first_template=false
                    else
                        templates_json="$templates_json,\n$template_entry"
                    fi
                fi
            done
        fi

        local build_entry="    \"$build_name\": {\n      \"workspace\": {\n$(echo -e "$workspace_json")\n      },\n      \"templates\": {\n$(echo -e "$templates_json")\n      }\n    }"

        if $first_build; then
            builds_json="$build_entry"
            first_build=false
        else
            builds_json="$builds_json,\n$build_entry"
        fi
    done

    cat > "$manifest_file" << EOF
{
  "manifest_version": "1.0",
  "generated": "$timestamp",
  "builds": {
$(echo -e "$builds_json")
  }
}
EOF

    echo "✓ Master manifest generated: $manifest_file"
}

generate_manifest

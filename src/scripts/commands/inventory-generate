#!/usr/bin/env bash
# templx inventory generate - generate template inventory markdown file

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"

if [[ "${1:-}" == "help" || "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    cat <<EOF
Usage: templx inventory generate

Generates docs/template-inventory.md from .templx/registry/agencies.json
and the master manifest at .templx/registry/manifest.json.
EOF
    exit 0
fi

timestamp=$(date -u +"%Y-%m-%d")
output_file="$PROJECT_ROOT/docs/template-inventory.md"
registry_file="$PROJECT_ROOT/.templx/registry/agencies.json"
manifest_file="$PROJECT_ROOT/.templx/registry/manifest.json"

echo "Generating template inventory..."
echo "Output: $output_file"
echo "Timestamp: $timestamp"

cat > "$output_file" << EOF
# Template Inventory & Status

Generated: $timestamp

EOF

if [[ ! -f "$registry_file" ]]; then
    echo "Error: Registry file not found: $registry_file" >&2
    exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
    echo "Error: jq is required for inventory generation" >&2
    exit 1
fi

add_agency_section() {
    local agency_code="$1"
    local agency_name="$2"
    local active="$3"

    {
        echo "## $agency_name"
        echo ""
        echo "| Template Name   | Status   |"
        echo "|-----------------|----------|"
    } >> "$output_file"

    local found_templates=false
    if [[ "$active" == "true" && -f "$manifest_file" ]]; then
        while IFS='|' read -r template_name status; do
            if [[ -n "$template_name" ]]; then
                echo "| $template_name | $status |" >> "$output_file"
                found_templates=true
            fi
        done < <(jq -r --arg agency "$agency_code" '.builds[$agency].workspace // {} | to_entries[] | "\(.key)|\(.value.status)"' "$manifest_file" 2>/dev/null)
        while IFS='|' read -r template_name status; do
            if [[ -n "$template_name" ]]; then
                echo "| $template_name | $status |" >> "$output_file"
                found_templates=true
            fi
        done < <(jq -r --arg agency "$agency_code" '.builds[$agency].templates // {} | to_entries[] | "\(.key)|\(.value.status)"' "$manifest_file" 2>/dev/null)
    fi

    if [[ "$found_templates" == "false" ]]; then
        echo "| No templates defined | - |" >> "$output_file"
    fi
    echo "" >> "$output_file"
}

jq -r '.agencies | to_entries | map(select(.key)) | .[] | "\(.key)|\(.value.name)|\(.value.active)"' "$registry_file" | while IFS='|' read -r agency_code agency_name active; do
    add_agency_section "$agency_code" "$agency_name" "$active"
done

echo "Template inventory created: $output_file"

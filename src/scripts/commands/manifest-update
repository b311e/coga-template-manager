#!/usr/bin/env bash
# templx manifest update command dispatcher

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SUBCOMMAND="${1:-}"

show_help() {
    cat <<EOF
Usage: templx manifest update <subcommand> [args...]

Subcommands:
  status <agency> <template> <status>  - Update a template's status in the master manifest
EOF
}

case "$SUBCOMMAND" in
    status)
        shift
        exec "$SCRIPT_DIR/manifest-update-status" "$@"
        ;;
    help|--help|-h|"")
        show_help
        ;;
    *)
        echo "Unknown manifest update subcommand: $SUBCOMMAND" >&2
        echo "Run 'templx manifest update help' for usage information." >&2
        exit 1
        ;;
esac

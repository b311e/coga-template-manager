#!/usr/bin/env bash
# OpenXML Unpack Alias
# Usage: unpack [file path]

set -euo pipefail

# Convert Windows path to Unix path if needed (for Git Bash on Windows)
normalize_path() {
    local path="$1"
    if [[ "$path" =~ ^[A-Za-z]:\\ ]]; then
        # Convert C:\path to /c/path format
        local drive_letter=$(echo "${path:0:1}" | tr '[:upper:]' '[:lower:]')
        local rest_of_path="${path:3}"
        rest_of_path="${rest_of_path//\\//}"
        echo "/$drive_letter/$rest_of_path"
    else
        echo "$path"
    fi
}

if [[ "$1" == "help" || "$1" == "--help" || "$1" == "-h" ]] 2>/dev/null; then
    echo "Usage: unpack <file path>"
    echo ""
    echo "Unpack OpenXML templates/documents into expanded folder structure"
    echo ""
    echo "Arguments:"
    echo "  file path  - Path to .dotx, .dotm, .xltx, .xltm, etc. file"
    echo ""
    echo "Examples:"
    echo "  unpack builds/jbc/foundation/normal/src/Normal.dotm"
    echo "  unpack builds/jbc/templates/memo/src/Memo.dotx"
    exit 0
fi

if [ $# -eq 0 ]; then
    echo "Usage: unpack [file path]"
    echo "Run 'unpack --help' for more information"
    exit 1
fi

# Get the script directory to find the project
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# PROJECT_ROOT should point to the repository root. The unpack script lives at:
#   <repo>/src/scripts/unpack/unpack
# so we need to go up three levels to reach the repo root.
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"

TEMPLATE_FILE="$(normalize_path "$1")"
# Make absolute if relative
if [[ "$TEMPLATE_FILE" != /* ]]; then
    TEMPLATE_FILE="$PWD/$TEMPLATE_FILE"
fi

if [ ! -f "$TEMPLATE_FILE" ]; then
    echo "Error: File not found: $TEMPLATE_FILE" >&2
    exit 1
fi

if [ $# -ge 2 ]; then
    OUTPUT_DIR="$(normalize_path "$2")"
    if [[ "$OUTPUT_DIR" != /* ]]; then
        OUTPUT_DIR="$PWD/$OUTPUT_DIR"
    fi
    # Explicit output: remove existing folder if present
    if [ -d "$OUTPUT_DIR" ]; then
        echo "Output folder already exists, removing: $OUTPUT_DIR"
        rm -rf "$OUTPUT_DIR"
    fi
else
    BASE_NAME="$(basename "$TEMPLATE_FILE")"
    BASE_NAME="${BASE_NAME%.*}"
    PARENT_DIR="$(dirname "$TEMPLATE_FILE")"
    OUTPUT_DIR="$PARENT_DIR/${BASE_NAME}_expanded"

    # If folder already exists, append timestamp to avoid removing user data
    if [ -d "$OUTPUT_DIR" ]; then
        TS="$(date -u +%Y%m%d%H%M%S)"
        OUTPUT_DIR="$PARENT_DIR/${BASE_NAME}_expanded_${TS}"
    fi
    echo "No output specified — unpacking to: $OUTPUT_DIR"
fi

mkdir -p "$OUTPUT_DIR"
unzip -q "$TEMPLATE_FILE" -d "$OUTPUT_DIR"
echo "Unpacked to: $OUTPUT_DIR"

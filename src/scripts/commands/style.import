#!/usr/bin/env bash
# templx style import command dispatcher

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SUBCOMMAND="${1:-}"

show_help() {
    cat <<EOF
Usage: templx style import <subcommand> [args...]

Subcommands:
  map <target> [--mapping <file>]   - Map-driven import from partials manifest
  partial <target> <snippet>        - Import all styles from a single snippet
  doc <target> <source-doc>         - Copy styles from one Word document to another
EOF
}

case "$SUBCOMMAND" in
    map)
        shift
        exec python "$SCRIPT_DIR/style.import.map" "$@"
        ;;
    partial)
        shift
        exec python "$SCRIPT_DIR/style.import.partial" "$@"
        ;;
    doc)
        shift
        exec dotnet run --project "$SCRIPT_DIR/style.import.doc" -- "$@"
        ;;
    help|--help|-h|"")
        show_help
        ;;
    *)
        echo "Unknown style import subcommand: $SUBCOMMAND" >&2
        echo "Run 'templx style import help' for usage information." >&2
        exit 1
        ;;
esac

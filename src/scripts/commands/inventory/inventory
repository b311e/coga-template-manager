#!/usr/bin/env bash
# templx inventory command dispatcher

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SUBCOMMAND="${1:-}"

show_help() {
    cat <<EOF
Usage: templx inventory <subcommand> [args...]

Subcommands:
  generate  - Generate template inventory markdown file at docs/template-inventory.md
EOF
}

case "$SUBCOMMAND" in
    generate)
        shift
        exec "$SCRIPT_DIR/generate" "$@"
        ;;
    help|--help|-h|"")
        show_help
        ;;
    *)
        echo "Unknown inventory subcommand: $SUBCOMMAND" >&2
        echo "Run 'templx inventory help' for usage information." >&2
        exit 1
        ;;
esac

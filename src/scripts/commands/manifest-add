#!/usr/bin/env bash
# templx manifest add command dispatcher

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SUBCOMMAND="${1:-}"

show_help() {
    cat <<EOF
Usage: templx manifest add <subcommand> [args...]

Subcommands:
  template <agency> <template> <type>  - Print instructions for adding a new template
EOF
}

case "$SUBCOMMAND" in
    template)
        shift
        exec "$SCRIPT_DIR/manifest-add-template" "$@"
        ;;
    help|--help|-h|"")
        show_help
        ;;
    *)
        echo "Unknown manifest add subcommand: $SUBCOMMAND" >&2
        echo "Run 'templx manifest add help' for usage information." >&2
        exit 1
        ;;
esac
